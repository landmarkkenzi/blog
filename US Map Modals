<!-- =========================================
     MODAL JAVASCRIPT
     ========================================= -->

<script>
(function() {

  const markers = document.querySelectorAll('.nps-map-marker');
  const modal = document.getElementById('nps-modal');
  const modalImage = document.getElementById('nps-modal-image');
  const modalTitle = document.getElementById('nps-modal-title');
  const modalClose = document.getElementById('nps-modal-close');

  if (!modal || !modalImage || !modalTitle || !modalClose) {
    return;
  }


  /* =========================================
     OPEN MODAL
     ========================================= */

  markers.forEach(function(marker) {

    marker.addEventListener('click', function() {

      const image = marker.getAttribute('data-image');
      const name = marker.getAttribute('data-name');

      modalImage.src = image;
      modalImage.alt = name;
      modalTitle.textContent = name;

      modal.classList.add('is-open');
      modal.setAttribute('aria-hidden', 'false');

      document.body.style.overflow = 'hidden';

    });

  });


  /* =========================================
     CLOSE MODAL
     ========================================= */

  function closeModal() {

    modal.classList.remove('is-open');
    modal.setAttribute('aria-hidden', 'true');

    modalImage.src = '';
    modalImage.alt = '';
    modalTitle.textContent = '';

    document.body.style.overflow = '';

  }


  modalClose.addEventListener('click', closeModal);


  /* =========================================
     CLOSE WHEN CLICKING OUTSIDE PHOTO
     ========================================= */

  modal.addEventListener('click', function(event) {

    if (event.target === modal) {
      closeModal();
    }

  });


  /* =========================================
     CLOSE WITH ESCAPE KEY
     ========================================= */

  document.addEventListener('keydown', function(event) {

    if (event.key === 'Escape' && modal.classList.contains('is-open')) {
      closeModal();
    }

  });

})();
</script>


<div>
  <p>
  This summer, we tried something a little different.
    </p>
<p>
We called it the National Park Travel Club, and joining was pretty simple: send us a postcard from your travels, and we'd send a little something back. A patch, a sticker, and a note welcoming you into our community of people who love getting mail and getting outdoors.
We weren't exactly sure what to expect. Then the postcards started showing up.
    </p>
<p>
They came from national parks, small towns, big cities, roadside stops, and a few places well beyond the U.S. Some had stories scribbled across every available inch. Others just said hello. We pinned them up as they arrived, and before long, we had this wonderfully imperfect record of where everyone had been.
    
That's really what we hoped the Travel Club would be about. Not checking parks off a list or taking the biggest trip. Just going somewhere, collecting a memory, and sharing a little piece of it with someone else.
</p>
<p>    
Now summer is winding down, and so is this year's Travel Club. As luck would have it, we're wrapping things up just as the National Park Service celebrates its 110th birthday.
    </p>
<p>
That feels like a pretty good reason to spread out the postcards one more time and celebrate all the places you've been.
    </p>
<p>
Thanks to everyone who sent us a little trail mail this summer. We had a lot of fun opening it.
    </p>
<p>
Happy 110th, National Park Service. And here's to wherever we all go next.
  </p>
