  top: 61%;
}

/* Rocky Mountains */
.nps-marker-4 {
  left: 28%;
  top: 42%;
}


/* Bryce Canyon */
.nps-marker-5 {
  left: 20%;
  top: 44%;
}


/* Great Smoky Mountains */
.nps-marker-7 {
  left: 63%;
  top: 53%;
}


/* Everglades */
.nps-marker-8 {
  left: 80%;
  top: 72%;
}


/* Denali */
.nps-marker-9 {
  left: 20%;
  top: 79%;
}


/* Haleakala */
.nps-marker-10 {
  left: 50%;
  top: 83%;
}


/* =========================================
   MODAL
   ========================================= */

.nps-modal {
  position: fixed;
  inset: 0;
  display: none;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  padding: 30px;
  box-sizing: border-box;
  background: rgba(0, 0, 0, 0.72);
  z-index: 999999;
  line-height: normal;
}

.nps-modal.is-open {
  display: flex;
}


/* =========================================
   MODAL CONTENT
   ========================================= */

.nps-modal-content {
  position: relative;
  width: min(760px, 100%);
  max-height: calc(100vh - 60px);
  overflow: hidden;
  box-sizing: border-box;
}


/* Photo */

.nps-modal-image {
  display: block;
  width: 100%;
  height: auto;
  max-height: calc(100vh - 130px);
  object-fit: contain;
}


